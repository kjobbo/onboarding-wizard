<% content_for :title, t(".title") %>

<div class="w-full max-w-xl mx-auto text-center">
  <div class="bg-white rounded-2xl shadow-lg ring-1 ring-gray-100 px-8 py-12 sm:px-12">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600"><%= t(".tagline") %></p>

    <h1 class="mt-4 text-4xl font-bold tracking-tight text-gray-900">
      <%= t(".heading") %>
    </h1>

    <p class="mt-4 text-lg text-gray-600">
      <%= t(".intro") %>
    </p>

    <%= button_to t(".sign_up"), onboarding_path,
          class: "mt-8 inline-flex items-center justify-center btn-primary" %>

    <p class="mt-6 text-sm text-gray-400"><%= t(".reassurance") %></p>
  </div>
</div>
