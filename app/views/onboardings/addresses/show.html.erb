<% content_for :title, t(".title") %>

<div class="w-full max-w-xl mx-auto">
  <div class="bg-white rounded-2xl shadow-lg ring-1 ring-gray-100 px-8 py-10 sm:px-12">
    <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600"><%= t(".step_badge") %></p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900"><%= t(".heading") %></h1>
    <p class="mt-2 text-gray-600"><%= t(".intro") %></p>

    <%= form_with model: @address, scope: :address,
                  url: onboarding_address_path, method: :patch,
                  class: "mt-8 space-y-6" do |form| %>
      <%= render "onboardings/field", form: form, attribute: :address_line_1 %>
      <%= render "onboardings/field", form: form, attribute: :address_line_2 %>

      <div class="grid grid-cols-1 gap-6 sm:grid-cols-2">
        <%= render "onboardings/field", form: form, attribute: :city %>
        <%= render "onboardings/field", form: form, attribute: :postcode %>
      </div>

      <%= render "onboardings/field", form: form, attribute: :country %>

      <div class="flex items-center justify-between gap-4 pt-2">
        <%= link_to t(".back"), onboarding_personal_details_path,
              class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>

        <%= form.submit t(".continue"), class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
