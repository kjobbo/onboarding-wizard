<% content_for :title, t(".title") %>

<div class="w-full max-w-xl mx-auto">
  <div class="bg-white rounded-2xl shadow-lg ring-1 ring-gray-100 px-8 py-10 sm:px-12">
    <% if @onboarding.completed? %>
      <div class="rounded-lg bg-green-50 px-4 py-3 text-sm font-medium text-green-800">
        <%= t(".completed_notice") %>
      </div>
      <h1 class="mt-6 text-3xl font-bold tracking-tight text-gray-900"><%= t(".completed_heading") %></h1>
    <% else %>
      <p class="text-sm font-semibold uppercase tracking-widest text-indigo-600"><%= t(".step_badge") %></p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-900"><%= t(".heading") %></h1>
      <p class="mt-2 text-gray-600"><%= t(".intro") %></p>
    <% end %>

    <div class="mt-8 space-y-8">
      <section>
        <div class="flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">
            <%= t("onboardings.steps.personal_details") %>
          </h2>
          <% unless @onboarding.completed? %>
            <%= link_to t(".edit"), onboarding_personal_details_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
          <% end %>
        </div>
        <div class="mt-2 rounded-lg border border-gray-200 px-4 py-3 text-gray-900">
          <p class="font-medium"><%= @onboarding.personal_details.full_name %></p>
          <p class="text-gray-600"><%= @onboarding.personal_details.email %></p>
        </div>
      </section>

      <section>
        <div class="flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">
            <%= t("onboardings.steps.address") %>
          </h2>
          <% unless @onboarding.completed? %>
            <%= link_to t(".edit"), onboarding_address_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
          <% end %>
        </div>
        <div class="mt-2 rounded-lg border border-gray-200 px-4 py-3 text-gray-900">
          <% @onboarding.address.lines.each do |line| %>
            <p><%= line %></p>
          <% end %>
        </div>
      </section>

      <section>
        <div class="flex items-baseline justify-between">
          <h2 class="text-sm font-semibold uppercase tracking-wide text-gray-500">
            <%= t("onboardings.steps.preferences") %>
          </h2>
          <% unless @onboarding.completed? %>
            <%= link_to t(".edit"), onboarding_preferences_path,
                  class: "text-sm font-semibold text-indigo-600 hover:text-indigo-500" %>
          <% end %>
        </div>
        <div class="mt-2 rounded-lg border border-gray-200 px-4 py-3 text-gray-900">
          <p class="font-medium">
            <%= t("onboardings.plans.#{@onboarding.preferences.plan}") %>
            &middot;
            <%= t("onboardings.billing_periods.#{@onboarding.preferences.billing_period}") %>
          </p>
          <p class="text-gray-600">
            <%= @onboarding.preferences.newsletter_opt_in? ? t(".newsletter_yes") : t(".newsletter_no") %>
          </p>
        </div>
      </section>
    </div>

    <% unless @onboarding.completed? %>
      <div class="mt-8 flex items-center justify-between gap-4">
        <%= link_to t(".back"), onboarding_preferences_path,
              class: "text-sm font-semibold text-gray-600 hover:text-gray-900" %>

        <%= button_to t(".confirm"), onboarding_completion_path, class: "btn-primary" %>
      </div>
    <% end %>
  </div>
</div>
